{"id": "gpt-unicode-16", "category": "unicode", "difficulty": "hard", "description": "An international identifier has 4 through 12 code points consisting only of Unicode letters, marks and ASCII digits. It starts with a letter, each letter may be followed by at most one mark, and every digit stands alone. It must include a mark and a digit; no adjacent digits.", "regex": "/^(?=.{4,12}$)(?=.*\\p{M})(?=.*[0-9])(?!.*[0-9]{2})\\p{L}\\p{M}?(?:\\p{L}\\p{M}?|[0-9])*$(?![\\s\\S])/u", "tests": {"match": ["áb1", "άβ4", "и́я5", "á1b", "a1b́", "ábcdefghij1"], "no_match": ["abc1", "ábc", "́ab1", "á̈b1", "áb12", "áb١", "á1́b", "ábcdefghijk1", "!áb1", "áb1!", "áb1\n", "áb1\r", "áb1\r\n", "áb1 ", "áb1 ", " áb1"]}, "examples": {"match": ["Äb3", "éx2"], "no_match": ["áb1 "]}}
{"id": "gpt-unicode-20", "category": "unicode", "difficulty": "hard", "description": "A Cyrillic echo code is two distinct Cyrillic-script Unicode letters, colon, the same two letters in reverse order. Each code point must be a letter, not a mark; equality is case sensitive and no normalization is done.", "regex": "/^((?=\\p{L})\\p{Script=Cyrillic})(?!\\1)((?=\\p{L})\\p{Script=Cyrillic}):\\2\\1$(?![\\s\\S])/u", "tests": {"match": ["Аб:бА", "Яя:яЯ", "Жз:зЖ", "Ий:йИ", "Юю:юЮ", "Бв:вБ", "Де:еД", "Зи:иЗ"], "no_match": ["АА:АА", "Аб:Аб", "Аб:ба", "Aб:бA", "А1:1А", "А́:́А", "Абб:ббА", "!Аб:бА", "Аб:бА!", "Аб:бА\n", "Аб:бА\r", "Аб:бА\r\n", "Аб:бА ", "Аб:бА ", " Аб:бА", "Аб:бА "]}}
{"id": "gpt-versions-17", "category": "versions", "difficulty": "hard", "description": "A release note capsule: the entire string has the literal opening wrapper VER{, a lowercase ASCII routing label of 2 through 6 letters, colon, a body, colon, the exact same routing label and the literal closing wrapper }VER. The body has 1 through 40 Unicode code points, allows any characters including line breaks and colons, and must contain the lowercase substring released. Only the body counts toward its length limit; no other text is allowed.", "regex": "/^VER\\{(?<route>[a-z]{2,6}):(?=.{1,40}:\\k<route>\\}VER$)(?=.{0,40}released.{0,40}:\\k<route>\\}VER$).*:\\k<route>\\}VER$(?![\\s\\S])/su", "tests": {"match": ["VER{aa:released:aa}VER", "VER{abcdef:areleased:abcdef}VER", "VER{tag:releasedb:tag}VER", "VER{route:\nreleased:route}VER", "VER{memo:released\n:memo}VER", "VER{ab:\treleased:ab}VER", "VER{zz:😀released:zz}VER", "VER{key:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxreleased:key}VER", "VER{xy:😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀released:xy}VER", "VER{aa:prefix: released: suffix:aa}VER"], "no_match": ["VER{aa::aa}VER", "VER{aa:abc:aa}VER", "VER{aa:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxreleased:aa}VER", "VER{aa:released:ab}VER", "VER{a:released:a}VER", "VER{abcdefg:released:abcdefg}VER", "VER{AA:released:AA}VER", "VER{aa:RELEASED:aa}VER", "VER{aa:released:aa", "aa:released:aa}VER", "VER{aa:😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀released:aa}VER", "!VER{aa:released:aa}VER", "VER{aa:released:aa}VER!", "VER{aa:released:aa}VER\n", "VER{aa:released:aa}VER\r", "VER{aa:released:aa}VER\r\n", "VER{aa:released:aa}VER ", "VER{aa:released:aa}VER ", " VER{aa:released:aa}VER", "VER{aa:released:aa}VER "]}}
{"id": "gpt-web-14", "category": "web", "difficulty": "hard", "description": "A route-alias record starts /alias/ and contains two identical lowercase ASCII slugs of 3 to 8 letters separated by slash. No trailing slash or spaces. Each of the two values must be enclosed in matching ASCII single or double quotes; the same quote character must be used for both values. Quotes are not part of the value, and escapes are not permitted.", "regex": "/^\\/alias\\/(['\\\"])([a-z]{3,8})\\1\\/\\1\\2\\1$(?![\\s\\S])/", "tests": {"match": ["/alias/'abc'/'abc'", "/alias/\"xyz\"/\"xyz\"", "/alias/'abcdefgh'/'abcdefgh'", "/alias/\"alias\"/\"alias\"", "/alias/'widget'/'widget'", "/alias/\"foo\"/\"foo\"", "/alias/'router'/'router'", "/alias/\"sample\"/\"sample\""], "no_match": ["/alias/'abc'/'xyz'", "/alias/'abc'/'abcabc'", "/alias/'?'/'?'", "/alias/'abc '/'abc'", "/alias/'abc'/' abc'", "/alias/'abc'/'abc/abc'", "/alias/'!!!'/'!!!'", "/alias/'ab'/'ab'", "/alias/'abc0'/'abc0'", "/alias/'000'/'000'", "/alias/'abc\"/'abc'", "/alias/'abc'/\"abc\"", "/alias/abc/abc", "!/alias/'abc'/'abc'", "/alias/'abc'/'abc'!", "/alias/'abc'/'abc'\n", "/alias/'abc'/'abc'\r", "/alias/'abc'/'abc'\r\n", "/alias/'abc'/'abc' ", "/alias/'abc'/'abc' ", " /alias/'abc'/'abc'", "/alias/'abc'/'abc' "]}}
{"id": "gpt-web-18", "category": "web", "difficulty": "hard", "description": "An LF-only route receipt has route= plus a lowercase ASCII slug of 3 to 8 letters on line one, and copy= plus the same slug on line two. No final LF or other content. Both values must be enclosed in matching ASCII single or double quotes, using the same quote character on both lines. The quotes are delimiters, not part of the value; no escapes are permitted.", "regex": "/^route=(['\\\"])([a-z]{3,8})\\1\\ncopy=\\1\\2\\1$(?![\\s\\S])/", "tests": {"match": ["route='abc'\ncopy='abc'", "route=\"xyz\"\ncopy=\"xyz\"", "route='abcdefgh'\ncopy='abcdefgh'", "route=\"route\"\ncopy=\"route\"", "route='widget'\ncopy='widget'", "route=\"foo\"\ncopy=\"foo\"", "route='router'\ncopy='router'", "route=\"sample\"\ncopy=\"sample\""], "no_match": ["route='abc'\ncopy='xyz'", "route='abc\r'\ncopy='abc'", "route=abc copy=abc", "route=abc\nCopy=abc", "route='?'\ncopy='?'", "route='abc'\ncopy='abc '", "route='!!!'\ncopy='!!!'", "route='ab'\ncopy='ab'", "route='abc0'\ncopy='abc0'", "route='000'\ncopy='000'", "route='abc\"\ncopy='abc'", "route='abc'\ncopy=\"abc\"", "route=abc\ncopy=abc", "route='abc'\r\ncopy='abc'", "!route='abc'\ncopy='abc'", "route='abc'\ncopy='abc'!", "route='abc'\ncopy='abc'\n", "route='abc'\ncopy='abc'\r", "route='abc'\ncopy='abc'\r\n", "route='abc'\ncopy='abc' ", "route='abc'\ncopy='abc' ", " route='abc'\ncopy='abc'", "route='abc'\ncopy='abc' "]}}
