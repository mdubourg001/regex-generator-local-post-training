{"id": "gpt-code-syntax-14", "category": "code-syntax", "difficulty": "hard", "description": "A simplified assignment is let, one space, a lowercase ASCII variable 3 to 8 letters, equals with one space on each side, and that same variable plus literal .length;. No other text or spaces.", "regex": "/^let ([a-z]{3,8}) = \\1\\.length;$(?![\\s\\S])/", "tests": {"match": ["let abc = abc.length;", "let xyz = xyz.length;", "let abcdefgh = abcdefgh.length;", "let value = value.length;", "let items = items.length;", "let foo = foo.length;", "let source = source.length;", "let sample = sample.length;"], "no_match": ["let abc = xyz.length;", "let ab = ab.length;", "let abcdefghi = abcdefghi.length;", "let ABC = ABC.length;", "let abc= abc.length;", "let abc = abcXlength;", "let abc = abc.length", "!let abc = abc.length;", "let abc = abc.length;!", "let abc = abc.length;\n", "let abc = abc.length;\r", "let abc = abc.length;\r\n", "let abc = abc.length; ", "let abc = abc.length; ", " let abc = abc.length;", "let abc = abc.length; "]}}
{"id": "gpt-code-syntax-18", "category": "code-syntax", "difficulty": "hard", "description": "An LF-only symbol receipt has symbol= and 3 to 8 lowercase ASCII letters on line one, then copy= with the identical symbol on line two. No final LF or extra whitespace. Both values must be enclosed in matching ASCII single or double quotes, using the same quote character on both lines. The quotes are delimiters, not part of the value; no escapes are permitted.", "regex": "/^symbol=(['\\\"])([a-z]{3,8})\\1\\ncopy=\\1\\2\\1$(?![\\s\\S])/", "tests": {"match": ["symbol='abc'\ncopy='abc'", "symbol=\"xyz\"\ncopy=\"xyz\"", "symbol='abcdefgh'\ncopy='abcdefgh'", "symbol=\"value\"\ncopy=\"value\"", "symbol='items'\ncopy='items'", "symbol=\"foo\"\ncopy=\"foo\"", "symbol='source'\ncopy='source'", "symbol=\"sample\"\ncopy=\"sample\""], "no_match": ["symbol='abc'\ncopy='xyz'", "symbol='abc\r'\ncopy='abc'", "symbol=abc copy=abc", "symbol=abc\nCopy=abc", "symbol='?'\ncopy='?'", "symbol='abc'\ncopy='abc '", "symbol='!!!'\ncopy='!!!'", "symbol='ab'\ncopy='ab'", "symbol='abc0'\ncopy='abc0'", "symbol='000'\ncopy='000'", "symbol='abc\"\ncopy='abc'", "symbol='abc'\ncopy=\"abc\"", "symbol=abc\ncopy=abc", "symbol='abc'\r\ncopy='abc'", "!symbol='abc'\ncopy='abc'", "symbol='abc'\ncopy='abc'!", "symbol='abc'\ncopy='abc'\n", "symbol='abc'\ncopy='abc'\r", "symbol='abc'\ncopy='abc'\r\n", "symbol='abc'\ncopy='abc' ", "symbol='abc'\ncopy='abc' ", " symbol='abc'\ncopy='abc'", "symbol='abc'\ncopy='abc' "]}}
{"id": "gpt-dates-times-15", "category": "dates-times", "difficulty": "hard", "description": "Code review requirement: A date token has a four-digit ASCII year, a separator chosen from slash or hyphen, month 01 through 12, the same separator, and day 01 through 31. Only ranges and format are checked, not calendar validity.", "regex": "/^[0-9]{4}([/-])(?:0[1-9]|1[0-2])\\1(?:0[1-9]|[12][0-9]|3[01])$(?![\\s\\S])/", "tests": {"match": ["2026-01-01", "2026/12/31", "0000-02-31", "9999/11/30", "1234-09-09", "2000/10/10", "2024-02-29", "0001/03/15"], "no_match": ["2026-01/01", "2026/01-01", "2026-00-01", "2026-13-01", "2026-01-00", "2026-01-32", "202-01-01", "!2026-01-01", "2026-01-01!", "2026-01-01\n", "2026-01-01\r", "2026-01-01\r\n", "2026-01-01 ", "2026-01-01 ", " 2026-01-01", "2026-01-01 "]}}
{"id": "gpt-dates-times-19", "category": "dates-times", "difficulty": "hard", "description": "Acceptance criteria: - A three-slot schedule consists of three different padded hours 00 through 23, separated by commas. No spaces; no hour can occur twice. - Evaluate the input as supplied; do not trim or normalize it.", "regex": "/^([01][0-9]|2[0-3]),(?!\\1,)([01][0-9]|2[0-3]),(?!\\1$)(?!\\2$)(?:[01][0-9]|2[0-3])$(?![\\s\\S])/", "tests": {"match": ["00,01,02", "23,22,21", "01,10,20", "09,00,23", "12,13,14", "20,21,22", "03,06,09", "10,11,12"], "no_match": ["00,00,01", "00,01,00", "00,01,01", "24,01,02", "01,24,02", "01,02,24", "1,02,03", "!00,01,02", "00,01,02!", "00,01,02\n", "00,01,02\r", "00,01,02\r\n", "00,01,02 ", "00,01,02 ", " 00,01,02", "00,01,02 "]}}
{"id": "gpt-dev-tooling-16", "category": "dev-tooling", "difficulty": "hard", "description": "A localized pipeline label: the literal prefix job: followed by 2 through 12 Unicode letter clusters. Each cluster is a Unicode letter followed by zero to two Unicode combining marks. One optional ASCII hyphen may join two nonempty runs of clusters, but no edge hyphen or second hyphen is allowed. Length counts letter clusters, excluding the hyphen and any fixed prefix; spaces, digits and other characters are forbidden. No normalization is performed.", "regex": "/^job:(?=(?:\\p{L}\\p{M}{0,2}-?){2,12}$)(?:\\p{L}\\p{M}{0,2}){1,12}(?:-(?:\\p{L}\\p{M}{0,2}){1,12})?$(?![\\s\\S])/u", "tests": {"match": ["job:ab", "job:éx", "job:á̈b", "job:Δέλτα", "job:مرحبا", "job:Зима", "job:abcdefghijkl", "job:é-ë", "job:Aé"], "no_match": ["job:a", "job:abcdefghijklm", "job:ab1", "job:a_b", "job:a b", "job:é", "job:😀a", "job:́ab", "job:á̈̃b", "job:-ab", "job:ab-", "job:a--b", "job:ab-cd-ef", "!job:ab", "job:ab!", "job:ab\n", "job:ab\r", "job:ab\r\n", "job:ab ", "job:ab ", " job:ab", "job:ab "]}, "examples": {"match": ["job:東京-大阪"], "no_match": []}}
{"id": "gpt-dev-tooling-20", "category": "dev-tooling", "difficulty": "hard", "description": "A workflow dependency is job: followed by a lowercase ASCII name 3 to 8 letters, then > and a different name with the same rules, then > and the exact first name again. No whitespace; neither name may be skip.", "regex": "/^job:(?!skip>)([a-z]{3,8})>(?!\\1>|skip>)[a-z]{3,8}>\\1$(?![\\s\\S])/", "tests": {"match": ["job:abc>xyz>abc", "job:build>test>build", "job:abcdefgh>deploy>abcdefgh", "job:skips>check>skips", "job:foo>bar>foo", "job:lint>types>lint", "job:pack>publish>pack", "job:left>right>left"], "no_match": ["job:abc>abc>abc", "job:abc>xyz>xyz", "job:skip>abc>skip", "job:abc>skip>abc", "job:ab>xyz>ab", "job:abc>abcdefghi>abc", "job:ABC>xyz>ABC", "!job:abc>xyz>abc", "job:abc>xyz>abc!", "job:abc>xyz>abc\n", "job:abc>xyz>abc\r", "job:abc>xyz>abc\r\n", "job:abc>xyz>abc ", "job:abc>xyz>abc ", " job:abc>xyz>abc", "job:abc>xyz>abc "]}}
