{"id": "gpt-measurements-14", "category": "measurements", "difficulty": "hard", "description": "A measurement check is check: and two identical readings separated by slash. Each reading is a canonical integer 1 through 99 followed by mm, no spaces or decimals. Each of the two values must be enclosed in matching ASCII single or double quotes; the same quote character must be used for both values. Quotes are not part of the value, and escapes are not permitted.", "regex": "/^check:(['\\\"])([1-9][0-9]?mm)\\1\\/\\1\\2\\1$(?![\\s\\S])/", "tests": {"match": ["check:'1mm'/'1mm'", "check:\"99mm\"/\"99mm\"", "check:'10mm'/'10mm'", "check:\"9mm\"/\"9mm\"", "check:'20mm'/'20mm'", "check:\"30mm\"/\"30mm\"", "check:'40mm'/'40mm'", "check:\"50mm\"/\"50mm\""], "no_match": ["check:'1mm'/'99mm'", "check:'1mm'/'1mm1mm'", "check:'?'/'?'", "check:'1mm '/'1mm'", "check:'1mm'/' 1mm'", "check:'1mm'/'1mm/1mm'", "check:'!!!'/'!!!'", "check:'1m'/'1m'", "check:'1mm0'/'1mm0'", "check:'zmm'/'zmm'", "check:'100'/'100'", "check:'1mm\"/'1mm'", "check:'1mm'/\"1mm\"", "check:1mm/1mm", "!check:'1mm'/'1mm'", "check:'1mm'/'1mm'!", "check:'1mm'/'1mm'\n", "check:'1mm'/'1mm'\r", "check:'1mm'/'1mm'\r\n", "check:'1mm'/'1mm' ", "check:'1mm'/'1mm' ", " check:'1mm'/'1mm'", "check:'1mm'/'1mm' "]}}
