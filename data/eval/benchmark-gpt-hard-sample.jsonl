{"id": "gpt-files-paths-15", "category": "files-paths", "difficulty": "hard", "description": "Code review requirement: A mirrored directory path is / followed by a lowercase ASCII directory name 3 to 8 letters, slash, the exact same name and .txt. The directory name must not be tmp or cache. No final slash.", "regex": "/^\\/(?!tmp\\/|cache\\/)([a-z]{3,8})\\/\\1\\.txt$(?![\\s\\S])/", "tests": {"match": ["/tmpx/tmpx.txt", "/cached/cached.txt", "/data/data.txt", "/report/report.txt", "/sample/sample.txt"], "no_match": ["/tmp/tmp.txt", "/cache/cache.txt", "/abc/xyz.txt", "/ab/ab.txt", "/abcdefghi/abcdefghi.txt", "/ABC/ABC.txt", "/abc/abcXtxt", "!/abc/abc.txt", "/abc/abc.txt!", "/abc/abc.txt\n", "/abc/abc.txt\r", "/abc/abc.txt\r\n", "/abc/abc.txt ", "/abc/abc.txt ", " /abc/abc.txt", "/abc/abc.txt "]}, "examples": {"match": ["/abc/abc.txt", "/abcdefgh/abcdefgh.txt", "/xyz/xyz.txt"], "no_match": []}}
